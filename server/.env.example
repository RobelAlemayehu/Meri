MONGO_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=hospitality
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
PORT=5000

NAV_WALKING_SPEED_MPS=1.4
NAV_ARRIVAL_RADIUS_M=20
# Optional: own OSRM base URL for production (default: public demo router)
# OSRM_BASE_URL=https://router.project-osrm.org
SUPERADMIN_SETUP_KEY=change_me_for_first_superadmin_only

# Google AI (Gemini) — required for POST /api/chat/query (conversational guide)
GEMINI_API_KEY=
# Stable default (see https://ai.google.dev/gemini-api/docs/models/gemini) — unversioned gemini-1.5-flash often 404s now
GEMINI_MODEL=gemini-2.5-flash
# Optional extra id to try after GEMINI_MODEL (server also auto-tries flash-latest, 2.0-flash on 404/quota)
# GEMINI_MODEL_FALLBACK=gemini-flash-latest
# Optional: 0–1, default 0.9 for more natural chat
# GEMINI_TEMPERATURE=0.9
