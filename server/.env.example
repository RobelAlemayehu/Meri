MONGO_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=hospitality
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
PORT=5000

NAV_WALKING_SPEED_MPS=1.4
NAV_ARRIVAL_RADIUS_M=20
# Optional: own OSRM base URL for production
# OSRM_BASE_URL=https://router.project-osrm.org

SUPERADMIN_SETUP_KEY=change_me_for_first_superadmin_only

# Google AI (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_FALLBACK=gemini-flash-latest
# GEMINI_TEMPERATURE=0.9

# SMTP — required for sending invite/rejection emails to applicants
# Gmail: enable 2FA then generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="Meri" <your_gmail@gmail.com>

# Frontend URL used in registration links sent by email
CLIENT_URL=http://localhost:5173

# How many days the invite token stays valid (default 14)
SUPERADMIN_INVITE_EXPIRY_DAYS=14
